# ---- Servidor ----
NODE_ENV=development
PORT=3100
# URL pública del sistema (se usa en los enlaces de recuperación y en la validación de origen)
APP_URL=http://localhost:3100

# ---- Base de datos PostgreSQL ----
DATABASE_URL=postgres://sentinela:sentinela_dev@localhost:5433/sentinela
# En hosting (Render, Neon, Supabase) normalmente se requiere SSL:
DATABASE_SSL=false

# ---- Seguridad ----
# Genere un valor aleatorio largo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambie_este_valor_por_uno_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_HOURS=2
BCRYPT_COST=12

# ---- Correo (recuperación de contraseña) ----
# Si SMTP_HOST queda vacío, el enlace de recuperación se muestra en la consola del servidor (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SentinelaPyME <no-responder@sentinelapyme.cl>"

# ---- Datos iniciales (seed) ----
ADMIN_EMAIL=admin@sentinelapyme.cl
ADMIN_PASSWORD="Admin#Sentinela2026"
SEED_EVENTOS=120000
